# Copy to .env and fill in. See docs/source/configuration.md for what each
# setting means. NEVER commit the real .env (it is in .gitignore).
#
# Settings that start with "#" are optional.

# --- Login accounts: ONE LINE of JSON. role is "admin" or "user". ----------
CBGP_USERS={"someadmin":{"password":"change-me","role":"admin"},"someuser":{"password":"change-me","role":"user"}}

# Signs session cookies. Generate one: ruby -rsecurerandom -e 'puts SecureRandom.hex(32)'
CBGP_SECRET=change-me-to-a-long-random-string

# --- Ontology --------------------------------------------------------------
CBGP_KB=https://w3id.org/CBGP-App

# --- Virtuoso (the two stores) ---------------------------------------------
# The password is set the first time each container starts: fill it in BEFORE
# the first `docker compose up`. docker-compose.yml overrides the two HOST
# values inside Docker, so the defaults below are fine there.
VIRTUOSO_HOST=localhost:18890
VIRTUOSO_USER=dba
VIRTUOSO_PASS=change-me
VIRTUOSO_HISTORY_HOST=localhost:18891
# Only if the history store needs different credentials (rare):
#HISTORY_USER=dba
#HISTORY_PASS=change-me

# --- Email to the administrators when a member submits a form --------------
NOTIFY_TO=admin@example.org
NOTIFY_FROM=cbgp-databases@example.org
NOTIFY_UN=change-me
NOTIFY_PW=change-me
NOTIFY_SMTP_ADDRESS=smtp.example.org
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_STARTTLS=true
NOTIFY_SMTP_AUTH=login

# --- Activity triggers (optional) -------------------------------------------
# Maps the symbolic recipient keys used in the ontology to real addresses.
#TRIGGER_RECIPIENTS={"photo_id_scheduler":"someone@example.org"}
# The address people use to reach this deployment (links in emails).
#APP_BASE_URL=https://admin.example.org

# --- Debugging (optional) ---------------------------------------------------
#CBGP_DEBUG_SPARQL=true

# --- MCP endpoint for AI agents (optional) ----------------------------------
# POST /mcp lets an agent (e.g. Hermes) query the data read-only. It is OFF
# unless this is set; the agent sends it as "Authorization: Bearer <token>".
# Generate one: ruby -rsecurerandom -e 'puts SecureRandom.hex(32)'
#MCP_TOKEN=change-me-to-a-long-random-string

# --- Chart branding (optional) -----------------------------------------------
# Colours, font and footer of drawn charts are read from a YAML file: theme/theme.yml next to the
# application (in Docker, mount ./theme at /server/theme), or the path below. See theme/theme.example.yml.
#CBGP_THEME_FILE=/server/theme/theme.yml
