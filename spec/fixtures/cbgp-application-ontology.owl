    <!-- https://w3id.org/CBGP-App#funding_commitment -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#funding_commitment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#forms"/>
        <rdfs:comment xml:lang="es">Qué porcentaje del coste salarial de un miembro se imputa a un proyecto, durante qué periodo. Un miembro financiado por varios proyectos tiene un registro por cada uno. Para cambiar un reparto, cierre el registro antiguo con una fecha de fin y añada uno nuevo.</rdfs:comment>
        <rdfs:comment xml:lang="en">What share of a member&apos;s salary cost is charged to a project, and for what period. A member funded by several projects has one record per project. To change a split, close the old record with an end date and add a new one.</rdfs:comment>
        <rdfs:label xml:lang="es">Compromiso de financiación</rdfs:label>
        <rdfs:label xml:lang="en">Funding Commitment</rdfs:label>
        <local:dbname xml:lang="en">commitment</local:dbname>
        <local:form-category xml:lang="en">Core</local:form-category>
        <local:has-fields rdf:resource="https://w3id.org/CBGP-App#new-commitment-questions"/>
        <local:has-related-records rdf:resource="https://w3id.org/CBGP-App#commitment_siblings_panel"/>
        <local:requires-field rdf:resource="https://w3id.org/CBGP-App#commitment_member"/>
        <local:requires-field rdf:resource="https://w3id.org/CBGP-App#commitment_percentage"/>
        <local:requires-field rdf:resource="https://w3id.org/CBGP-App#commitment_project"/>
        <local:requires-field rdf:resource="https://w3id.org/CBGP-App#commitment_start_date"/>
    </owl:Class>
    


