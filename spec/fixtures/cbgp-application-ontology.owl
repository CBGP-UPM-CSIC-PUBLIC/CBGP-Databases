    <!-- https://w3id.org/CBGP-App#ui-text -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui-text">
        <rdfs:comment xml:lang="en">Interface text the application shows around the data (hints inside boxes, captions of small buttons). Each subclass is ONE piece of text: its English and Spanish rdfs:label are what the user sees. A %{name} inside a label is filled in by the application (the comment on each text says which names exist); write it exactly the same, in every language, and run check_ontology.rb after editing. Do not rename these classes - the application finds each text by its class name.</rdfs:comment>
        <rdfs:label xml:lang="en">Interface text</rdfs:label>
        <rdfs:label xml:lang="es">Texto de la interfaz</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_curate_back -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_curate_back">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Link back to the record as it was submitted, from the page where it is being curated under a full form.</rdfs:comment>
        <rdfs:label xml:lang="en">Back to the submitted view</rdfs:label>
        <rdfs:label xml:lang="es">Volver a la vista enviada</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_curate_not_kept -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_curate_not_kept">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Warning listing the values a submitted record holds that the form it is being curated under has no field for; followed by the list.</rdfs:comment>
        <rdfs:label xml:lang="en">Entered by the submitter but not on this form - these will not be kept when you save (the earlier version stays in the history):</rdfs:label>
        <rdfs:label xml:lang="es">Introducido por quien lo envió pero no está en este formulario: no se conservará al guardar (la versión anterior permanece en el historial):</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_curate_notice -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_curate_notice">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Shown on the full form that a submitted record is being curated under. %{form} is that form name.</rdfs:comment>
        <rdfs:label xml:lang="en">Curating this submitted record as %{form}. Nothing changes until you save.</rdfs:label>
        <rdfs:label xml:lang="es">Está clasificando este registro enviado como %{form}. No se cambia nada hasta que guarde.</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_curate_panel_body -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_curate_panel_body">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Followed by one link per full form the record can be curated under.</rdfs:comment>
        <rdfs:label xml:lang="en">Review what was entered below, then curate it as:</rdfs:label>
        <rdfs:label xml:lang="es">Revise lo introducido más abajo y después clasifíquelo como:</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_curate_panel_title -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_curate_panel_title">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Heading of the panel an administrator sees above a record that is still on a user-facing (simplified) form, before choosing which full form to curate it under.</rdfs:comment>
        <rdfs:label xml:lang="es">Este registro se envió mediante un formulario simplificado y aún no está clasificado.</rdfs:label>
        <rdfs:label xml:lang="en">This record was submitted through a simplified form and has not been classified yet.</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_dbname_all_types -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_dbname_all_types">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Generic name of the all-forms search entry for a storage name several forms share, used when no specific ui_dbname_ text exists for it. %{name} is the storage name.</rdfs:comment>
        <rdfs:label xml:lang="en">%{name} (all types)</rdfs:label>
        <rdfs:label xml:lang="es">%{name} (todos los tipos)</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_dbname_project -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_dbname_project">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Name, in the Query list, of the search that covers every kind of project form (they all store under the name project).</rdfs:comment>
        <rdfs:label xml:lang="en">Projects (all types)</rdfs:label>
        <rdfs:label xml:lang="es">Proyectos (todos los tipos)</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_entry_today -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_entry_today">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Caption of the button beside each date box of a data-entry form: fills the box with today&apos;s date (the date itself is saved).</rdfs:comment>
        <rdfs:label xml:lang="es">Hoy</rdfs:label>
        <rdfs:label xml:lang="en">Today</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_required_when -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_required_when">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Small note beside a field that is required only under a condition (e.g. dates only when the project is Awarded).</rdfs:comment>
        <rdfs:label xml:lang="es">Obligatorio cuando %{when_field} es %{answer}</rdfs:label>
        <rdfs:label xml:lang="en">Required when %{when_field} is %{answer}</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_required_when_error -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_required_when_error">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Error shown when a conditionally required field is left empty.</rdfs:comment>
        <rdfs:label xml:lang="es">%{field} es obligatorio cuando %{when_field} es %{answer}</rdfs:label>
        <rdfs:label xml:lang="en">%{field} is required when %{when_field} is %{answer}</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_search_all_shown -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_search_all_shown">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Shown above the results of Show all records. %{count} is the number of records.</rdfs:comment>
        <rdfs:label xml:lang="es">Se muestran todos los registros (%{count}).</rdfs:label>
        <rdfs:label xml:lang="en">Showing all records (%{count}).</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_search_categories_search -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_search_categories_search">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Hint inside the search box above a category tree on a data entry form.</rdfs:comment>
        <rdfs:label xml:lang="es">Buscar categorías...</rdfs:label>
        <rdfs:label xml:lang="en">Search categories...</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_search_categories_type -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_search_categories_type">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Hint inside the search box of a category tree on the search form.</rdfs:comment>
        <rdfs:label xml:lang="es">Escriba para buscar categorías...</rdfs:label>
        <rdfs:label xml:lang="en">Type to search categories...</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_search_enter_field_to_filter -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_search_enter_field_to_filter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Hint inside a text search box. Placeholder: %{field} = the field&apos;s label in lower case.</rdfs:comment>
        <rdfs:label xml:lang="en">Enter %{field} to filter</rdfs:label>
        <rdfs:label xml:lang="es">Introduzca %{field} para filtrar</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_search_enter_url_part -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_search_enter_url_part">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Hint inside the search box of a web-address field.</rdfs:comment>
        <rdfs:label xml:lang="en">Enter part of the web address to filter</rdfs:label>
        <rdfs:label xml:lang="es">Introduzca parte de la dirección web para filtrar</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_search_enter_value -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_search_enter_value">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Hint inside a plain search box.</rdfs:comment>
        <rdfs:label xml:lang="en">Enter value</rdfs:label>
        <rdfs:label xml:lang="es">Introduzca un valor</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_search_no_terms -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_search_no_terms">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Shown when a search form is submitted with every box empty; followed by the Show all records link.</rdfs:comment>
        <rdfs:label xml:lang="es">No se ha introducido nada que buscar.</rdfs:label>
        <rdfs:label xml:lang="en">Nothing was entered to search for.</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_search_not_exclude -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_search_not_exclude">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Caption of the tick box that turns a search condition around (find the records that do NOT match).</rdfs:comment>
        <rdfs:label xml:lang="es">NO (excluir coincidencias)</rdfs:label>
        <rdfs:label xml:lang="en">NOT (exclude matches)</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_search_number_example -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_search_number_example">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Hint inside a number or amount search box. Placeholder: %{example} = an example number written the way the user&apos;s language writes it.</rdfs:comment>
        <rdfs:label xml:lang="en">e.g. %{example}</rdfs:label>
        <rdfs:label xml:lang="es">p. ej. %{example}</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_search_or_empty -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_search_or_empty">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Caption of the tick box that widens a search condition to also match records that have no value at all in that field (e.g. a project with no end date).</rdfs:comment>
        <rdfs:label xml:lang="es">o sin valor</rdfs:label>
        <rdfs:label xml:lang="en">or no value</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_search_show_all -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_search_show_all">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Link on every search page that lists every record, with no search terms.</rdfs:comment>
        <rdfs:label xml:lang="es">Mostrar todos los registros</rdfs:label>
        <rdfs:label xml:lang="en">Show all records</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_search_today -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_search_today">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Caption of the tick box beside each date box of a search: use the day the search is run instead of a fixed date.</rdfs:comment>
        <rdfs:label xml:lang="es">Hoy (cambia cada día)</rdfs:label>
        <rdfs:label xml:lang="en">Today (changes daily)</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_search_today_note -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_search_today_note">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Notice on a results page whose search used today instead of a date; %{date} is the day it was read as.</rdfs:comment>
        <rdfs:label xml:lang="es">En esta búsqueda, “hoy” significa %{date}. No es una fecha fija: la misma búsqueda ejecutada mañana usará la fecha de mañana.</rdfs:label>
        <rdfs:label xml:lang="en">In this search, “today” means %{date}. It is not a fixed date: the same search run tomorrow will use tomorrow’s date.</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_typeahead_add_another -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_typeahead_add_another">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Caption of the button that adds one more row to a repeatable box (shown after a plus sign).</rdfs:comment>
        <rdfs:label xml:lang="en">Add another</rdfs:label>
        <rdfs:label xml:lang="es">Añadir otro</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_typeahead_clear -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_typeahead_clear">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Caption of the button that empties a chosen cross-reference value (shown after a cross sign).</rdfs:comment>
        <rdfs:label xml:lang="es">borrar</rdfs:label>
        <rdfs:label xml:lang="en">clear</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_typeahead_hint -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_typeahead_hint">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Hint inside a cross-reference box that searches another kind of record. Placeholders: %{target} = the kind of record searched (e.g. member).</rdfs:comment>
        <rdfs:label xml:lang="es">Escriba al menos 2 caracteres para buscar en «%{target}»...</rdfs:label>
        <rdfs:label xml:lang="en">Type at least 2 characters to search existing %{target}...</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_typeahead_hint_field -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_typeahead_hint_field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Same hint when the box searches by a named field. Placeholders: %{field} = the field typed into (e.g. Surname(s)), %{target} = the kind of record searched.</rdfs:comment>
        <rdfs:label xml:lang="es">Escriba al menos 2 caracteres de «%{field}» para buscar en «%{target}»...</rdfs:label>
        <rdfs:label xml:lang="en">Type at least 2 characters of the %{field} to search existing %{target}...</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_typeahead_hint_field_plain -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_typeahead_hint_field_plain">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Same as the field hint, for a box whose target kind of record has no name in the ontology. Placeholder: %{field} = the field typed into.</rdfs:comment>
        <rdfs:label xml:lang="es">Escriba al menos 2 caracteres de «%{field}» para buscar...</rdfs:label>
        <rdfs:label xml:lang="en">Type at least 2 characters of the %{field} to search...</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_typeahead_hint_plain -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_typeahead_hint_plain">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Same as the first hint, for a box whose target kind of record has no name in the ontology. No placeholders.</rdfs:comment>
        <rdfs:label xml:lang="es">Escriba al menos 2 caracteres para buscar...</rdfs:label>
        <rdfs:label xml:lang="en">Type at least 2 characters to search...</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_typeahead_remove -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_typeahead_remove">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Caption of the button that removes one row of a repeatable box (shown after a minus sign).</rdfs:comment>
        <rdfs:label xml:lang="es">quitar</rdfs:label>
        <rdfs:label xml:lang="en">remove</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ui_typeahead_stored_value -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ui_typeahead_stored_value">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#ui-text"/>
        <rdfs:comment xml:lang="en">Caption in front of the value a cross-reference box currently holds and will store (e.g. the DNI/NIE/PAS).</rdfs:comment>
        <rdfs:label xml:lang="en">Currently selected value</rdfs:label>
        <rdfs:label xml:lang="es">Valor seleccionado actualmente</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#uk -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#uk">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#country"/>
        <rdfs:label xml:lang="es">Reino Unido</rdfs:label>
        <rdfs:label xml:lang="en">United Kingdom</rdfs:label>
        <local:answer-order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">196</local:answer-order>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#ukraine -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#ukraine">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#country"/>
        <rdfs:label xml:lang="es">Ucrania</rdfs:label>
        <rdfs:label xml:lang="en">Ukraine</rdfs:label>
        <local:answer-order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">194</local:answer-order>
