        <rdfs:label xml:lang="es">Fecha de fin</rdfs:label>
        <local:answer-block rdf:resource="https://w3id.org/CBGP-App#DATE"/>
        <local:is-primary-id rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</local:is-primary-id>
