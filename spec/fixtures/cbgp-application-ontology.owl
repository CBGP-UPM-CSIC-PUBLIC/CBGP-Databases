    <!-- https://w3id.org/CBGP-App#european_research_project -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#european_research_project">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#forms"/>
        <rdfs:comment xml:lang="es">Proyectos de investigación financiados por la Comisión Europea. Cada uno tiene título, investigador principal y co-IP (vinculados a registros de miembros), convocatoria, financiación y costes indirectos por año, fechas y estado (Propuesto, Concedido, Rechazado o Retirado). Se almacenan junto con los demás formularios de proyecto.</rdfs:comment>
        <rdfs:comment xml:lang="en">Research projects funded by the European Commission. Each has a title, principal investigator and co-PI (linked to member records), call, funding and overheads per year, dates and status (Proposed, Awarded, Rejected or Withdrawn). Stored together with the other project forms.</rdfs:comment>
        <rdfs:label xml:lang="es">Proyectos Públicos de Investigación de la Comisión Europea</rdfs:label>
        <rdfs:label xml:lang="en">Public European Commision Research Projects</rdfs:label>
        <local:dbname xml:lang="en">project</local:dbname>
        <local:form-category xml:lang="en">Core</local:form-category>
        <local:has-conditional-requirements rdf:resource="https://w3id.org/CBGP-App#european_project_end_date_when_awarded"/>
        <local:has-conditional-requirements rdf:resource="https://w3id.org/CBGP-App#european_project_start_date_when_awarded"/>
        <local:has-defaults rdf:resource="https://w3id.org/CBGP-App#european_research_project_funding_institution_default"/>
        <local:has-defaults rdf:resource="https://w3id.org/CBGP-App#european_research_project_status_default"/>
        <local:has-fields rdf:resource="https://w3id.org/CBGP-App#new-european-research-project-questions"/>
        <local:has-formulas rdf:resource="https://w3id.org/CBGP-App#european_research_project_cbgp_overheads_formula"/>
        <local:has-formulas rdf:resource="https://w3id.org/CBGP-App#european_research_project_overheads_formula"/>
        <local:has-related-records rdf:resource="https://w3id.org/CBGP-App#project_commitments_panel"/>
        <local:requires-field rdf:resource="https://w3id.org/CBGP-App#project_affiliation"/>
        <local:requires-field rdf:resource="https://w3id.org/CBGP-App#project_application_url"/>
        <local:requires-field rdf:resource="https://w3id.org/CBGP-App#project_call_for_proposal_title"/>
        <local:requires-field rdf:resource="https://w3id.org/CBGP-App#project_funding_institution"/>
        <local:requires-field rdf:resource="https://w3id.org/CBGP-App#project_internal_code"/>
        <local:requires-field rdf:resource="https://w3id.org/CBGP-App#project_pi_nie"/>
        <local:requires-field rdf:resource="https://w3id.org/CBGP-App#project_title"/>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#european_research_project_cbgp_overheads_formula -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#european_research_project_cbgp_overheads_formula">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#formula-definition"/>
        <rdfs:comment xml:lang="en">60% of total overheads</rdfs:comment>
        <rdfs:label xml:lang="en">Formula for the CBGP overheads of European Commision Research Projects</rdfs:label>
        <rdfs:label xml:lang="es">Fórmula para los costes indirectos del CBGP para Proyectos de Investigación de la Comisión Europea</rdfs:label>
        <local:formula-expression>european_research_project_total_overheads * 0.6</local:formula-expression>
        <local:formula-for-field rdf:resource="https://w3id.org/CBGP-App#project_cbgp_overheads"/>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#european_research_project_coordination_group -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#european_research_project_coordination_group">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#new-european-research-project-questions"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#new-project-questions"/>
        <rdfs:label xml:lang="en">Is the coordination group from CBGP/CSIC?</rdfs:label>
        <rdfs:label xml:lang="es">¿El grupo coordinador del proyecto pertenece al CBGP/CSIC?</rdfs:label>
        <local:answer-block rdf:resource="https://w3id.org/CBGP-App#coordination_group"/>
        <local:is-primary-id rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</local:is-primary-id>
        <local:method>coordination_group</local:method>
        <local:object-class>String</local:object-class>
        <local:question-order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</local:question-order>
        <local:widget-cardinality>Single</local:widget-cardinality>
        <local:widget-type rdf:resource="https://w3id.org/CBGP-App#radio"/>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#european_research_project_funding_institution_default -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#european_research_project_funding_institution_default">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#pre-populated-answer"/>
        <rdfs:label xml:lang="en">European research project funding institution default</rdfs:label>
        <rdfs:label xml:lang="es">Institución financiadora por defecto de proyecto público de investigación europeo</rdfs:label>
        <local:default-for-field rdf:resource="https://w3id.org/CBGP-App#project_funding_institution"/>
        <local:default-value rdf:resource="https://w3id.org/CBGP-App#public_european_commision"/>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#european_research_project_overheads_formula -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#european_research_project_overheads_formula">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#formula-definition"/>
        <rdfs:comment xml:lang="en">25% of total funding</rdfs:comment>
        <rdfs:label xml:lang="en">Formula for the total overheads of European Commision Research Projects</rdfs:label>
        <rdfs:label xml:lang="es">Fórmula para los costes totales de Proyectos de Investigación de la Comisión Europea</rdfs:label>
        <local:formula-expression>european_private_research_project_total_funding * 0.25</local:formula-expression>
        <local:formula-for-field rdf:resource="https://w3id.org/CBGP-App#european_research_project_total_overheads"/>
    </owl:Class>
    


    <!-- https://w3id.org/CBGP-App#european_research_project_status_default -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#european_research_project_status_default">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#pre-populated-answer"/>
        <rdfs:comment xml:lang="en">Added 2026-09-25. Both the public submission form and the admin
edit form render this field identically (no per-interface visibility
mechanism exists yet) - defaulting to &quot;Proposed&quot; here is trusted, not
enforced, same as every other field a public submitter fills in; the
admin&apos;s review of every submitted record is what keeps it honest.</rdfs:comment>
        <rdfs:label xml:lang="es">Estado por defecto de proyecto de investigación europeo</rdfs:label>
        <rdfs:label xml:lang="en">European research project status default</rdfs:label>
        <local:default-for-field rdf:resource="https://w3id.org/CBGP-App#project_status"/>
        <local:default-value>Proposed</local:default-value>
    </owl:Class>
    


