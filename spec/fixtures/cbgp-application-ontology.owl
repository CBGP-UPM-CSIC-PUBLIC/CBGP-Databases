    <!-- https://w3id.org/CBGP-App#userproject -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#userproject">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#forms"/>
        <rdfs:comment xml:lang="en">A project application announced by a member through the user-facing form, before the administrators curate it into one of the project forms. Each has a title, principal investigator, co-PI, funding, call and status. Stored together with the project forms.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una solicitud de proyecto comunicada por un miembro mediante el formulario de usuario, antes de que la administración la clasifique en uno de los formularios de proyecto. Incluye título, investigador principal, co-IP, financiación, convocatoria y estado. Se almacena junto con los formularios de proyecto.</rdfs:comment>
        <rdfs:label xml:lang="en">User Project</rdfs:label>
        <rdfs:label xml:lang="es">User Project</rdfs:label>
        <local:dbname xml:lang="en">project</local:dbname>
        <local:form-category xml:lang="en">UserFacing</local:form-category>
        <local:has-fields rdf:resource="https://w3id.org/CBGP-App#user-project-fields"/>
        <local:requires-field rdf:resource="https://w3id.org/CBGP-App#project_application_url"/>
        <local:requires-field rdf:resource="https://w3id.org/CBGP-App#project_pi_nie"/>
    </owl:Class>
    


