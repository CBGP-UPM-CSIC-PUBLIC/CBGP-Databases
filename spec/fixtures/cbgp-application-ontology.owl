        <rdfs:label xml:lang="es">Estado por defecto de proyecto de investigación privado</rdfs:label>
        <rdfs:label xml:lang="en">Private research project status default</rdfs:label>
        <local:default-for-field rdf:resource="https://w3id.org/CBGP-App#project_status"/>
        <local:default-value>Proposed</local:default-value>
    </owl:Class>
    


