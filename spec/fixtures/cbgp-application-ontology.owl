    <!-- https://w3id.org/CBGP-App#personnel_project -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#personnel_project">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#forms"/>
        <rdfs:comment xml:lang="en">Projects or fellowships that pay the salary of one person, the beneficiary. Each has the beneficiary and principal investigator (linked to member records), total funding, dates and status. Stored together with the other project forms.</rdfs:comment>
        <rdfs:comment xml:lang="es">Proyectos o ayudas que financian el salario de una persona, la beneficiaria. Cada uno indica beneficiario e investigador principal (vinculados a registros de miembros), financiación total, fechas y estado. Se almacenan junto con los demás formularios de proyecto.</rdfs:comment>
        <rdfs:label xml:lang="en">Personnel Project</rdfs:label>
        <rdfs:label xml:lang="es">Proyecto Personal</rdfs:label>
        <local:dbname xml:lang="en">project</local:dbname>
        <local:form-category xml:lang="en">Core</local:form-category>
        <local:has-conditional-requirements rdf:resource="https://w3id.org/CBGP-App#personnel_project_end_date_when_awarded"/>
        <local:has-conditional-requirements rdf:resource="https://w3id.org/CBGP-App#personnel_project_start_date_when_awarded"/>
        <local:has-defaults rdf:resource="https://w3id.org/CBGP-App#personnel_project_status_default"/>
        <local:has-fields rdf:resource="https://w3id.org/CBGP-App#new-personnel-project-questions"/>
        <local:has-related-records rdf:resource="https://w3id.org/CBGP-App#project_commitments_panel"/>
        <local:requires-field rdf:resource="https://w3id.org/CBGP-App#beneficiary_nie"/>
        <local:requires-field rdf:resource="https://w3id.org/CBGP-App#project_affiliation"/>
        <local:requires-field rdf:resource="https://w3id.org/CBGP-App#project_application_url"/>
        <local:requires-field rdf:resource="https://w3id.org/CBGP-App#project_funding_entity"/>
        <local:requires-field rdf:resource="https://w3id.org/CBGP-App#project_internal_code"/>
        <local:requires-field rdf:resource="https://w3id.org/CBGP-App#project_pi_nie"/>
        <local:requires-field rdf:resource="https://w3id.org/CBGP-App#project_title"/>
    </owl:Class>
    


