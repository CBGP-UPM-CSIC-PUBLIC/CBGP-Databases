    <!-- https://w3id.org/CBGP-App#member -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#member">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#forms"/>
        <rdfs:comment xml:lang="en">People who work or study at the institute: employees, staff, researchers, students and visitors, one record per person (contact details, category, research group, start and end dates). The status field says whether a person is currently Active, Inactive or Historical; the current staff are those with status Active.</rdfs:comment>
        <rdfs:comment xml:lang="es">Personas que trabajan o estudian en el instituto: empleados, personal, investigadores, estudiantes y visitantes, un registro por persona (datos de contacto, categoría, grupo de investigación, fechas de inicio y fin). El campo estado indica si una persona está Activa, Inactiva o es Histórica; el personal actual es el que tiene estado Activo.</rdfs:comment>
        <rdfs:label xml:lang="en">Member</rdfs:label>
        <rdfs:label xml:lang="es">Miembro</rdfs:label>
        <local:dbname xml:lang="en">member</local:dbname>
        <local:form-category xml:lang="en">Core</local:form-category>
        <local:has-fields rdf:resource="https://w3id.org/CBGP-App#new-member-questions"/>
        <local:has-related-records rdf:resource="https://w3id.org/CBGP-App#member_commitments_panel"/>
        <local:has-triggers rdf:resource="https://w3id.org/CBGP-App#member_new_submission_trigger"/>
    </owl:Class>
    


