    <!-- https://w3id.org/CBGP-App#national_regional_research_project_year1_cbgp_overheads_formula -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#national_regional_research_project_year1_cbgp_overheads_formula">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#formula-definition"/>
        <rdfs:comment xml:lang="en">60% of overheads for year 1</rdfs:comment>
        <rdfs:label xml:lang="en">Formula for the CBGP overheads of year 1 of National and Regional Research Projects</rdfs:label>
        <rdfs:label xml:lang="es">Fórmula para los costes indirectos del CBGP del año 1 de Proyectos de Investigación Nacionales y Regionales</rdfs:label>
        <local:formula-expression>year1_overheads * 0.6</local:formula-expression>
        <local:formula-for-field rdf:resource="https://w3id.org/CBGP-App#year1_cbgp_overheads"/>
    </owl:Class>
    


