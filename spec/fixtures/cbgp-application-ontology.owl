    <!-- https://w3id.org/CBGP-App#conditional-requirement -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#conditional-requirement">
        <rdfs:comment xml:lang="en">A rule a form lists via local:has-conditional-requirements: a field that is required only when another field has one of certain answers (e.g. the dates of a project are required only once it is Awarded). Each instance names local:conditional-requirement-field (the field that becomes required), local:conditional-requirement-when-field (the field whose answer decides) and one or more local:conditional-requirement-when-answer (the answer classes that make it required). Each instance belongs to one form. Enforced when a record is saved; the form shows a small note beside the field. check_ontology.rb verifies that every part is present and every class named exists.</rdfs:comment>
        <rdfs:label xml:lang="en">Conditional requirement</rdfs:label>
        <rdfs:label xml:lang="es">Requisito condicional</rdfs:label>
    </owl:Class>
    


