    <!-- https://w3id.org/CBGP-App#national_regional_research_project -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#national_regional_research_project">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#forms"/>
        <rdfs:comment xml:lang="es">Proyectos de investigación financiados por organismos nacionales o regionales. Cada uno tiene título, investigador principal y co-IP (vinculados a registros de miembros), convocatoria, financiación y costes indirectos por año, fechas y estado (Propuesto, Concedido, Rechazado o Retirado). Se almacenan junto con los demás formularios de proyecto.</rdfs:comment>
        <rdfs:comment xml:lang="en">Research projects funded by national or regional bodies. Each has a title, principal investigator and co-PI (linked to member records), call, funding and overheads per year, dates and status (Proposed, Awarded, Rejected or Withdrawn). Stored together with the other project forms.</rdfs:comment>
        <rdfs:label xml:lang="en">National and Regional Research Projects</rdfs:label>
        <rdfs:label xml:lang="es">Proyectos de Investigacion Nacionales y Regionales</rdfs:label>
        <local:dbname xml:lang="en">project</local:dbname>
        <local:form-category xml:lang="en">Core</local:form-category>
        <local:has-conditional-requirements rdf:resource="https://w3id.org/CBGP-App#national_regional_project_end_date_when_awarded"/>
        <local:has-conditional-requirements rdf:resource="https://w3id.org/CBGP-App#national_regional_project_start_date_when_awarded"/>
        <local:has-defaults rdf:resource="https://w3id.org/CBGP-App#national_regional_research_project_status_default"/>
        <local:has-fields rdf:resource="https://w3id.org/CBGP-App#new-national-regional-research-project-questions"/>
        <local:has-formulas rdf:resource="https://w3id.org/CBGP-App#national_regional_research_project_year1_cbgp_overheads_formula"/>
        <local:has-formulas rdf:resource="https://w3id.org/CBGP-App#national_regional_research_project_year2_cbgp_overheads"/>
        <local:has-formulas rdf:resource="https://w3id.org/CBGP-App#national_regional_research_project_year3_cbgp_overheads"/>
        <local:has-formulas rdf:resource="https://w3id.org/CBGP-App#national_regional_research_project_year4_cbgp_overheads"/>
        <local:has-related-records rdf:resource="https://w3id.org/CBGP-App#project_commitments_panel"/>
        <local:requires-field rdf:resource="https://w3id.org/CBGP-App#project_affiliation"/>
        <local:requires-field rdf:resource="https://w3id.org/CBGP-App#project_application_url"/>
        <local:requires-field rdf:resource="https://w3id.org/CBGP-App#project_call_for_proposal_title"/>
        <local:requires-field rdf:resource="https://w3id.org/CBGP-App#project_funding_institution"/>
        <local:requires-field rdf:resource="https://w3id.org/CBGP-App#project_internal_code"/>
        <local:requires-field rdf:resource="https://w3id.org/CBGP-App#project_pi_nie"/>
        <local:requires-field rdf:resource="https://w3id.org/CBGP-App#project_title"/>
    </owl:Class>
    


