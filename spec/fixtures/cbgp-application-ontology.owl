    <!-- https://w3id.org/CBGP-App#project_status -->

    <owl:Class rdf:about="https://w3id.org/CBGP-App#project_status">
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#new-european-research-project-questions"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#new-national-regional-research-project-questions"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#new-personnel-project-questions"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#new-private-research-project-questions"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#new-programa-propio-research-project-questions"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#new-project-questions"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#user-project-fields"/>
        <rdfs:comment>Added 2026-09-25 at Mark&apos;s request. Tracks whether this record is
a submitted proposal not yet decided, or a finalized outcome - distinct
from the funding-amount field, whose absence doesn&apos;t reliably tell &quot;still
pending&quot; apart from &quot;rejected&quot; apart from &quot;not yet entered&quot;. Needed to
answer proposal-success-rate questions, which a funding amount alone
cannot. subClassOf every project-family section, same membership as
project_title, so it&apos;s reachable from every Research/Personnel project
form (European/national-regional/private/personnel) - see
project_funding_entity&apos;s comment for why fields shared across forms don&apos;t
get a &quot;personnel_&quot;-prefixed duplicate name.

Defaults to &quot;Proposed&quot; on every project form via local:has-defaults (see
each form&apos;s own declaration) - trusted, not enforced: the public-facing
submission form and the admin edit form render the identical field today
(no per-interface visibility mechanism exists in this app yet), so the
admin&apos;s own review of every submitted record is what actually keeps this
honest, same as it already is for every other field on that form.</rdfs:comment>
        <rdfs:label xml:lang="es">Estado de financiación</rdfs:label>
        <rdfs:label xml:lang="en">Funding status</rdfs:label>
        <local:answer-block rdf:resource="https://w3id.org/CBGP-App#project-status"/>
        <local:is-primary-id rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</local:is-primary-id>
        <local:method>status</local:method>
        <local:object-class>String</local:object-class>
        <local:question-order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35</local:question-order>
        <local:widget-cardinality>Single</local:widget-cardinality>
        <local:widget-type rdf:resource="https://w3id.org/CBGP-App#radio"/>
    </owl:Class>
    


