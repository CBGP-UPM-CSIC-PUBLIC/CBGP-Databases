        <rdfs:label xml:lang="en">The start date of a national regional research project is required once it is Awarded</rdfs:label>
        <local:conditional-requirement-field rdf:resource="https://w3id.org/CBGP-App#project_start_date"/>
        <local:conditional-requirement-when-answer rdf:resource="https://w3id.org/CBGP-App#Awarded"/>
