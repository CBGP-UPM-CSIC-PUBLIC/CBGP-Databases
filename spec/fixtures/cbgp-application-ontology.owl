        <rdfs:subClassOf rdf:resource="https://w3id.org/CBGP-App#new-project-questions"/>
        <rdfs:label xml:lang="es">Total de costes indirectos</rdfs:label>
        <rdfs:label xml:lang="en">Total overheads</rdfs:label>
