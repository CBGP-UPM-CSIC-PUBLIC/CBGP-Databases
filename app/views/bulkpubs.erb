<!DOCTYPE html>
<!--[if lt IE 7]> <html class="no-js ie6 oldie" lang="en"> <![endif]-->
<!--[if IE 7]>    <html class="no-js ie7 oldie" lang="en"> <![endif]-->
<!--[if IE 8]>    <html class="no-js ie8 oldie" lang="en"> <![endif]-->
<!--[if gt IE 8]><!--> <html class="no-js" lang="en"> <!--<![endif]-->
  
  <%= erb :_head %>

  <body>
  <script>
    function openActionPanel(cid) {
      var x = document.getElementById(cid);
      if (x.style.display === "none") {
        x.style.display = "block";
      } else {
        x.style.display = "none";
      }
    }
  </script>

  
      <%= erb :_logo_head %>



    <div style="clear: both;">
      <br/><br/>
      <h1>CBGP - Publications Upload</h1>
      <br/>
      <% if @messages && @messages.any? %>
      <div class="error-messages">
        <ul>
          <% @messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
      <% if @orcid_job_id %>
      <div id="orcid-mining-status" data-job-id="<%= @orcid_job_id %>">
        Looking up missing ORCIDs for the newly-loaded authors in the background
        (about <%= (@orcid_estimate_seconds / 60.0).ceil %> minute(s) estimated)...
      </div>
      <script>
        (function () {
          var el = document.getElementById('orcid-mining-status');
          if (!el) return;
          var jobId = el.getAttribute('data-job-id');
          var poll = function () {
            fetch('/cbgp/publications/bulk/orcid_status/' + jobId)
              .then(function (res) { return res.json(); })
              .then(function (job) {
                if (job.done) {
                  el.textContent = 'ORCID lookup finished: ' + job.found + ' of ' + job.total + ' found.';
                } else {
                  el.textContent = 'Looking up missing ORCIDs... ' + job.searched + ' of ' + job.total + ' checked so far.';
                  setTimeout(poll, 3000);
                }
              })
              .catch(function () { /* job may have expired on an app restart - stop polling silently */ });
          };
          setTimeout(poll, 3000);
        })();
      </script>
      <% end %>
    </div>

    <div class="databases">
    
      <form action="/cbgp/publications/bulk" method="POST">
      <table id="publication_lookup" width="30%">
        <tr> <th>Add Publications in Bulk</th> </tr>
        <tr> <td>
          <input type="submit" value="Submit"/>
        </td></tr>
        <tr> <td>
          <label for='dois'>DOI List (one per line)</label>
          <textarea id="dois" name="dois" rows="10" cols="50"></textarea><br>
        </td></tr>
        <tr> <td>
          <input type="submit" value="Submit"/>
        </td></tr>
      </table>
      </form>
 
    </div>


    <div style="clear: both;">
      <%= erb :_footer %>
    </div>


    <script src="http://ajax.googleapis.com/ajax/libs/jquery/1/jquery.min.js"></script>
    <!--[if lt IE 7]>
      <script src="//ajax.googleapis.com/ajax/libs/chrome-frame/1.0.2/CFInstall.min.js"></script>
      <script>window.attachEvent("onload",function(){CFInstall.check({mode:"overlay"})})</script>
    <![endif]-->
  </body>
</html>


